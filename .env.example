# Base URL of the Laravel API (no trailing slash). All application routes live
# under `${NEXT_PUBLIC_API_URL}/api`; the Sanctum CSRF cookie is served from
# `${NEXT_PUBLIC_API_URL}/sanctum/csrf-cookie`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Name of the Laravel session cookie, used ONLY by middleware.ts for a coarse
# authenticated/guest redirect. Laravel derives it from APP_NAME
# (Str::slug(APP_NAME, '_') . '_session'); with APP_NAME=Laravel it is
# `laravel_session`. Note: in a split-origin dev setup (front :3000 / api :8000)
# this cookie is scoped to the API origin and is NOT visible to Next middleware,
# so the client-side route guard (src/lib/auth) remains authoritative.
NEXT_PUBLIC_SESSION_COOKIE=laravel_session
